#pragma once

#include "rtx/pass/sharc_args.h"

static const uint kCacheUpdateQueryReservoirEmpty = 0u;
static const uint kCacheUpdateQueryOffsetBitsPerAxis = SHARC_UPDATE_QUERY_OFFSET_BITS_PER_AXIS;
static const uint kCacheUpdateQueryOffsetMask = (1u << kCacheUpdateQueryOffsetBitsPerAxis) - 1u;
static const uint kCacheUpdateQueryKeyShift = 2u * kCacheUpdateQueryOffsetBitsPerAxis;

uint packCacheUpdateQueryReservoirEntry(uint key, uvec2 queryPixelOffsetInCell)
{
  return (key << kCacheUpdateQueryKeyShift) |
         ((queryPixelOffsetInCell.y & kCacheUpdateQueryOffsetMask) << kCacheUpdateQueryOffsetBitsPerAxis) |
         (queryPixelOffsetInCell.x & kCacheUpdateQueryOffsetMask);
}

uvec2 unpackCacheUpdateQueryPixelOffset(uint reservoirEntry)
{
  return uvec2(reservoirEntry & kCacheUpdateQueryOffsetMask,
               (reservoirEntry >> kCacheUpdateQueryOffsetBitsPerAxis) & kCacheUpdateQueryOffsetMask);
}

bool isCacheUpdateQueryPixelOffsetRepresentable(uvec2 queryPixelOffsetInCell)
{
  return all(queryPixelOffsetInCell <= uvec2(kCacheUpdateQueryOffsetMask));
}
