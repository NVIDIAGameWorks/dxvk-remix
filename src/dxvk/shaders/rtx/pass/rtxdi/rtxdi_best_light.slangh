#pragma once

// Returns the previous frame's best light near prevPixelCenter, mapped to the current frame.
// Initial sampling and temporal reuse must call this with the same RNG state
// so that temporal reuse skips the same random numbers.
void loadPreviousBestLight(
  inout RAB_RandomSamplerState rng,
  ivec2 prevPixelCenter,
  out uint16_t previousBestLightIndex,
  out uint8_t previousBestLightPortalIdx) {
  previousBestLightIndex = RTXDI_INVALID_LIGHT_INDEX;
  previousBestLightPortalIdx = RTXDI_INVALID_PORTAL_INDEX;

  if (all(prevPixelCenter >= 0) && all(prevPixelCenter < cb.camera.resolution) && cb.enableRtxdiBestLightSampling) {
    // Jitters the lookup by up to one pixel, so edge pixels sometimes use a neighbouring block's best light.
    ivec2 bestLightPixel = prevPixelCenter;
    if (cb.enableRtxdiBestLightJitter) {
      const ivec2 bestLightOffset = ivec2(vec2(RAB_GetNextRandom(rng), RAB_GetNextRandom(rng)) * 3) - 1;
      bestLightPixel = clamp(prevPixelCenter + bestLightOffset, ivec2(0), ivec2(cb.camera.resolution) - 1);
    }

    const uint2 previousBestLight = RtxdiBestLights[bestLightPixel / RTXDI_GRAD_FACTOR];

    // A cross-portal light is only kept if its portal still exists.
#if RTXDI_NO_PORTALS
    if (previousBestLight.x != RTXDI_INVALID_LIGHT_INDEX && previousBestLight.y == RTXDI_INVALID_PORTAL_INDEX) {
#else
    if (previousBestLight.x != RTXDI_INVALID_LIGHT_INDEX && (previousBestLight.y == RTXDI_INVALID_PORTAL_INDEX || previousBestLight.y < cb.numActiveRayPortals)) {
#endif
      previousBestLightIndex = RAB_TranslateLightIndex(previousBestLight.x, /* currentToPrevious = */ false);
      previousBestLightPortalIdx = previousBestLight.y;
    }
  }
}
