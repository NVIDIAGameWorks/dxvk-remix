#pragma once

#include "particle_spawn_distribution.h"

groupshared float particleDistributionScan[kParticleDistributionBlockSize];

float scanParticleDistributionBlock(float value, uint lane) {
  particleDistributionScan[lane] = value;
  GroupMemoryBarrierWithGroupSync();
  for (uint stride = 1; stride < kParticleDistributionBlockSize; stride *= 2) {
    const float preceding = lane >= stride ? particleDistributionScan[lane - stride] : 0.0f;
    GroupMemoryBarrierWithGroupSync();
    particleDistributionScan[lane] += preceding;
    GroupMemoryBarrierWithGroupSync();
  }
  // Preserve prefix ordering and zero-weight exclusion.
  // Differently associated sums can decrease or give zero-weight lanes an interval.
  // Only positive weights contribute candidates to the monotone prefix envelope.
  particleDistributionScan[lane] = value > 0.0f ? particleDistributionScan[lane] : 0.0f;
  GroupMemoryBarrierWithGroupSync();
  for (uint stride = 1; stride < kParticleDistributionBlockSize; stride *= 2) {
    const float preceding = lane >= stride ? particleDistributionScan[lane - stride] : 0.0f;
    GroupMemoryBarrierWithGroupSync();
    particleDistributionScan[lane] = max(particleDistributionScan[lane], preceding);
    GroupMemoryBarrierWithGroupSync();
  }
  return particleDistributionScan[lane];
}

void buildParticleDistributionBlock(RWStructuredBuffer<float> distribution, uint offset,
                                    uint triangleCount, uint block, uint lane, float area) {
  const uint triangle = block * kParticleDistributionBlockSize + lane;
  const float prefix = scanParticleDistributionBlock(area, lane);
  if (triangle < triangleCount) {
    distribution[offset + triangle] = prefix;
  }
  if (lane == kParticleDistributionBlockSize - 1) {
    distribution[offset + triangleCount + block] = prefix;
  }
}

// Runs in a single workgroup after the triangle-block writes are visible.
void finalizeParticleDistribution(RWStructuredBuffer<float> distribution, uint offset,
                                 uint triangleCount, uint lane) {
  const uint blockCount = particleDistributionBlockCount(triangleCount);
  float precedingBatches = 0.0f;
  for (uint first = 0; first < blockCount; first += kParticleDistributionBlockSize) {
    const uint block = first + lane;
    const float area = block < blockCount ? distribution[offset + triangleCount + block] : 0.0f;
    const float prefix = scanParticleDistributionBlock(area, lane);
    if (block < blockCount) {
      distribution[offset + triangleCount + block] = precedingBatches + prefix;
    }
    precedingBatches += particleDistributionScan[kParticleDistributionBlockSize - 1];
    GroupMemoryBarrierWithGroupSync();
  }
}
