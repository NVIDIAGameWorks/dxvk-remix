static const uint kReprojectionConfidenceHistoryLength = 16;

#define RAB_SURFACE_BACKGROUND_HIT_DISTANCE -1.0

#define RAB_RTXDI_MIN_PERCEPTUAL_ROUGHNESS 0.03
#define RAB_RTXDI_MIN_ROUGHNESS (RAB_RTXDI_MIN_PERCEPTUAL_ROUGHNESS*RAB_RTXDI_MIN_PERCEPTUAL_ROUGHNESS)

#define RAB_RESTIR_GI_MAX_SPECULAR_BRDF 10000
// ReSTIR GI doesn't work well for low roughness surfaces, they need to be handled separately.
// The threshold here is based on experiment, might need further adjustment if we find failed cases.
#define RAB_RESTIR_GI_MIN_ROUGHNESS 0.3
#define RAB_RESTIR_GI_DELTA_ROUGHNESS 0.02
#define RAB_RESTIR_GI_VISIBILITY_SHORTENING 0.98

#define RESTIR_GI_FLAG_NON_OPAQUE_HIT (0x1 << 28)

#ifndef RTXDI_NO_PORTALS
#define RTXDI_NO_PORTALS 0
#endif

// The selection prepasses set RTXDI_TEMPORAL_SELECTION_PASS or RTXDI_SPATIAL_SELECTION_PASS and fill the neighbor caches.
// With compact reservoirs, the reuse passes merge the cached neighbors. See RAB_UseSparseReservoirs.
#ifndef RTXDI_TEMPORAL_SELECTION_PASS
#define RTXDI_TEMPORAL_SELECTION_PASS 0
#endif

#ifndef RTXDI_SPATIAL_SELECTION_PASS
#define RTXDI_SPATIAL_SELECTION_PASS 0
#endif

struct RAB_RandomSamplerState
{
  uint seed;
  uint index;
};

uint murmur3(inout RAB_RandomSamplerState r)
{
#define ROT32(x, y) ((x << y) | (x >> (32 - y)))

  // https://en.wikipedia.org/wiki/MurmurHash
  uint c1 = 0xcc9e2d51;
  uint c2 = 0x1b873593;
  uint r1 = 15;
  uint r2 = 13;
  uint m = 5;
  uint n = 0xe6546b64;

  uint hash = r.seed;
  uint k = r.index++;
  k *= c1;
  k = ROT32(k, r1);
  k *= c2;

  hash ^= k;
  hash = ROT32(hash, r2) * m + n;

  hash ^= 4;
  hash ^= (hash >> 16);
  hash *= 0x85ebca6b;
  hash ^= (hash >> 13);
  hash *= 0xc2b2ae35;
  hash ^= (hash >> 16);

#undef ROT32

  return hash;
}

float sampleUniformRng(inout RAB_RandomSamplerState r)
{
  uint v = murmur3(r);
  const uint one = floatBitsToUint(1.f);
  const uint mask = (1 << 23) - 1;
  return uintBitsToFloat((mask & v) | one) - 1.f;
}

uint sampleUniformIntRng(inout RAB_RandomSamplerState r)
{
  return murmur3(r);
}


// Depending on the surface type, the position/normal/viewDirection members are in different coordinate systems.
// For a surface reflected in a mirror, they are in the virtual world space.
// For a surface inside a portal, they are in the "portal space": the world space for the corresponding actual objects.
// Otherwise, they are in the world space.
// hitDistance is the total ray length when the surface is hit.
struct RAB_Surface
{
  MinimalRayInteraction minimalRayInteraction;
  MinimalSurfaceInteraction minimalSurfaceInteraction;
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction;

  float hitDistance;
  PortalSpace2BitsType portalSpace;
  bool isViewModel;
  uint8_t objectMask;

  float3 virtualWorldPosition;
  bool hasStaticObjectMotion;
};

typedef LightSample RAB_LightSample;

RAB_LightSample RAB_EmptyLightSample()
{
  return (RAB_LightSample)0;
}

float RAB_GetLightSampleSolidAnglePDF(RAB_LightSample lightSample)
{
  return lightSample.solidAnglePdf;
}

bool RAB_IsSurfaceValid(RAB_Surface surface)
{
  return surface.hitDistance != RAB_SURFACE_BACKGROUND_HIT_DISTANCE;
}

float3 RAB_GetSurfaceWorldPos(RAB_Surface surface)
{
  return surface.minimalSurfaceInteraction.position;
}

float3 RAB_GetSurfaceNormal(RAB_Surface surface)
{
  return surface.opaqueSurfaceMaterialInteraction.shadingNormal;
}

float3 RAB_GetTriangleNormal(RAB_Surface surface)
{
  return surface.minimalSurfaceInteraction.geometryNormal;
}

float3 RAB_GetViewDirection(RAB_Surface surface)
{
  return surface.minimalRayInteraction.viewDirection;
}

float RAB_GetSurfaceLinearDepth(RAB_Surface surface)
{
  return surface.hitDistance;
}

uint RAB_GetSurfacePortalSpace(RAB_Surface surface)
{
  return surface.portalSpace;
}

bool RAB_IsSurfaceInCombinedPortalSpace(RAB_Surface surface)
{
  return surface.portalSpace == PORTAL_SPACE_PORTAL_COMBINED;
}

RAB_Surface RAB_EmptySurface()
{
  RAB_Surface surface = (RAB_Surface)0;
  surface.minimalRayInteraction.viewDirection = vec3(0, 0, 1);
  surface.minimalSurfaceInteraction.geometryNormal = vec3(0, 0, 1);
  surface.minimalSurfaceInteraction.geometryTangent = vec3(1, 0, 0);
  surface.minimalSurfaceInteraction.geometryBitangent = vec3(0, 1, 0);
  surface.opaqueSurfaceMaterialInteraction.shadingNormal = vec3(0, 0, 1);
  surface.opaqueSurfaceMaterialInteraction.albedo = vec3(0, 0, 1);
  surface.opaqueSurfaceMaterialInteraction.baseReflectivity = vec3(0, 0, 1);
  surface.opaqueSurfaceMaterialInteraction.isotropicRoughness = 1.0f;
  surface.opaqueSurfaceMaterialInteraction.anisotropicRoughness = vec2(1, 1);
  surface.opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.packedTransmittanceColor = 0;
  surface.opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.measurementDistance = 0.0h;
  surface.opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.packedSingleScatteringAlbedo = 0;
  surface.opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.volumetricAnisotropy = 0.0h;
  surface.opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.maxSampleRadius = 0.0h;
  surface.hitDistance = RAB_SURFACE_BACKGROUND_HIT_DISTANCE;
  surface.portalSpace = PORTAL_SPACE_NONE;
  surface.isViewModel = false;
  surface.objectMask = 0;
  surface.virtualWorldPosition = 0;
  return surface;
}

vec3 UnpackOctahedralNormal(float packedNormal)
{
  uint32_t packedNormalI = floatBitsToUint(packedNormal);
  return signedOctahedralToSphereDirection(snorm2x16ToFloat2x32(packedNormalI));
}

vec2 RAB_PackLastFrameGBuffer(RAB_Surface surface)
{
  const vec2 octahedralShadingNormal = sphereDirectionToSignedOctahedral(surface.opaqueSurfaceMaterialInteraction.shadingNormal);
  uint32_t packedShadingNormal = float2x32ToSnorm2x16(octahedralShadingNormal);
  packedShadingNormal = (packedShadingNormal & 0xfffefffe) | (uint32_t(surface.portalSpace & 0x2) << 15) | uint32_t(surface.portalSpace & 0x1);

  vec2 gbufferData;
  gbufferData.x = surface.hitDistance;
  gbufferData.y = uintBitsToFloat(packedShadingNormal);
  return gbufferData;
}

void RAB_TransformSurface(inout RAB_Surface surface, mat4 transformMatrix)
{
  mat3 normalTransform = mat3(transformMatrix);

  surface.minimalRayInteraction.viewDirection = mul(normalTransform, vec3(surface.minimalRayInteraction.viewDirection));
  surface.minimalSurfaceInteraction = minimalSurfaceInteractionAffineTransform(surface.minimalSurfaceInteraction, transformMatrix);
  surface.opaqueSurfaceMaterialInteraction.shadingNormal = mul(normalTransform, vec3(surface.opaqueSurfaceMaterialInteraction.shadingNormal));
}

mat4 RAB_GetPortalTransform(uint8_t portalIdx)
{
  return cb.rayPortalHitInfos[uint(portalIdx)].encodedPortalToOpposingPortalDirection.unpack();
}

bool RAB_IsPortalActive(uint8_t portalIdx)
{
  return cb.rayPortalHitInfos[uint(portalIdx)].encodedPortalToOpposingPortalDirection.isActive();
}

uint8_t RAB_GetOppositePortal(uint8_t lightPortal)
{
  if (lightPortal == RTXDI_INVALID_PORTAL_INDEX)
    return RTXDI_INVALID_PORTAL_INDEX;
  return lightPortal ^ 1;
}

uint16_t RAB_TranslateLightIndex(uint16_t lightIndex, bool currentToPrevious)
{
  if (lightIndex == RTXDI_INVALID_LIGHT_INDEX)
    return RTXDI_INVALID_LIGHT_INDEX;

  return lightMapping[lightIndex + (currentToPrevious ? 0 : cb.lightCount)];
}

// Reservoirs written while identity resolution is disabled have no stored identity. Allow
// those reservoirs to use the legacy single-frame remap when identity resolution is enabled.
#ifndef RTXDI_LIGHT_IDENTITY_LEGACY_FALLBACK
#define RTXDI_LIGHT_IDENTITY_LEGACY_FALLBACK 1
#endif

bool RAB_UseLightIdentityResolution()
{
    return cb.sparseRenderingArgs.enableLightIdentityResolution != 0;
}

// Returns the runtime-stable 32-bit identity of the light currently at the given index.
uint RAB_GetLightIdentity(uint currentLightIdx)
{
  return lightIdentities[currentLightIdx].x;
}

// Resolves an opaque light identity to its current light-buffer index via a binary search 
uint16_t RAB_ResolveLightIndexFromIdentity(uint identity)
{
  uint lo = cb.lightCount;
  uint hi = 2u * cb.lightCount; // exclusive upper bound of the sorted section

  while (lo < hi)
  {
    const uint mid = (lo + hi) >> 1;

    // Unsigned compare of the 32-bit key, matching the CPU sort.
    if (lightIdentities[mid].x < identity)
    {
      lo = mid + 1;
    }
    else
    {
      hi = mid;
    }
  }

  if (lo < 2u * cb.lightCount && lightIdentities[lo].x == identity)
    return uint16_t(lightIdentities[lo].y);

  return RTXDI_INVALID_LIGHT_INDEX;
}

// Resolves a (possibly stale) reservoir's stored light index to the current frame using its
// stable identity. Returns false if the referenced light is no longer present this frame.
bool RAB_ResolveReservoirLightIndex(inout RTXDI_Reservoir reservoir)
{
  if (!RTXDI_IsValidReservoir(reservoir))
    return false;

  // Fast path: the same light is still at the stored index (no renumber affected it).
  if (uint(reservoir.lightIdx) < cb.lightCount &&
      RAB_GetLightIdentity(reservoir.lightIdx) == reservoir.lightIdentity)
  {
    return true;
  }

  // The light was renumbered, or the reservoir is stale: recover its current index by identity.
  const uint16_t resolvedIdx = RAB_ResolveLightIndexFromIdentity(reservoir.lightIdentity);
  if (resolvedIdx != RTXDI_INVALID_LIGHT_INDEX)
  {
    reservoir.lightIdx = resolvedIdx;
    return true;
  }

#if RTXDI_LIGHT_IDENTITY_LEGACY_FALLBACK
  if (reservoir.lightIdentity == 0u)
  {
    const uint16_t mappedIdx = RAB_TranslateLightIndex(reservoir.lightIdx, /* currentToPrevious = */ false);
    reservoir.lightIdx = mappedIdx;
    if (mappedIdx == RTXDI_INVALID_LIGHT_INDEX)
    {
      return false;
    }

    // The index is current now; stamping its identity keeps a later resolve from translating it again.
    reservoir.lightIdentity = RAB_GetLightIdentity(mappedIdx);
    return true;
  }
#endif

  reservoir.lightIdx = RTXDI_INVALID_LIGHT_INDEX;
  return false;
}

#ifdef RAB_HAS_COMPACTED_GBUFFER
// Inactive pixels store no base reflectivity, so spatial reuse lends its inactive neighbors the one of the pixel it resamples.
static vec3 g_resampledPixelBaseReflectivity = vec3(0.0f);

// Rebuilds the surface of a pixel without a compacted GBuffer slot from the outputs the GBuffer writes at every pixel.
// Returns an empty surface for a miss.
RAB_Surface RAB_GetInactiveGBufferSurface(ivec2 pixel)
{
  RAB_Surface surface = RAB_EmptySurface();

  const MinimalSurfaceInteraction minimalSurfaceInteraction =
    minimalSurfaceInteractionReadFromGBuffer(pixel, PrimaryWorldPositionWorldTriangleNormalDense);

  if (!minimalSurfaceInteraction.isValid)
  {
    return surface;
  }

  // PSR reflections and repeated portal crossings turn the view ray in ways that cannot be redone here, so those surfaces are left out.
  const GeometryFlags geometryFlags = geometryFlagsReadFromGBuffer(pixel, SharedFlagsDense);
  if (geometryFlags.performPSRR || geometryFlags.portalSpace == PORTAL_SPACE_PORTAL_COMBINED)
  {
    return surface;
  }

  const CameraDirections cameraDirections = cameraPixelCoordinateToDirection(cb.camera, pixel, false);
  const float hitDistance = PrimaryLinearViewZ[pixel] / cameraDirections.viewDirection.z;

  // A portal turns the view ray by the transform of the portal the ray entered.
  vec3 viewDirection = -cameraDirections.worldDirection;
  if (geometryFlags.portalSpace == PORTAL_SPACE_PORTAL_0 || geometryFlags.portalSpace == PORTAL_SPACE_PORTAL_1)
  {
    const uint8_t entryPortalIndex = uint8_t(geometryFlags.portalSpace - PORTAL_SPACE_PORTAL_0);
    viewDirection = normalize(mul(mat3(RAB_GetPortalTransform(entryPortalIndex)), viewDirection));
  }

  // A view direction behind the triangle zeroes every light's target, and the active pixel's reuse would count that empty history.
  if (dot(viewDirection, minimalSurfaceInteraction.geometryNormal) <= 0.0f)
  {
    return surface;
  }

  surface.minimalRayInteraction.viewDirection = viewDirection;
  surface.minimalRayInteraction.coneRadius = cb.screenSpacePixelSpreadHalfAngle * hitDistance;

  // The position error is compacted, so only its world-space term is recomputed here.
  surface.minimalSurfaceInteraction = minimalSurfaceInteraction;
  surface.minimalSurfaceInteraction.positionError = calculatePositionError(minimalSurfaceInteraction.position);
#ifdef SHADOW_TERMINATOR_FIX_ALLOWED
  if (cb.shadowTerminatorArgs.enableOffset)
  {
    surface.minimalSurfaceInteraction.shadowTerminatorOffset = SharedTerminatorFix[pixel];
  }
#endif

  surface.opaqueSurfaceMaterialInteraction.shadingNormal =
    signedOctahedralToSphereDirection(snorm2x16ToFloat2x32(PrimaryWorldShadingNormalDense[pixel]));
  // The DLSS-RR diffuse albedo guide is the only albedo written at every pixel.
  surface.opaqueSurfaceMaterialInteraction.albedo = PrimaryAlbedoDLSSRR[pixel].rgb;
  surface.opaqueSurfaceMaterialInteraction.opacity = 1.0;
  surface.opaqueSurfaceMaterialInteraction.baseReflectivity = g_resampledPixelBaseReflectivity;
  surface.opaqueSurfaceMaterialInteraction.emissiveRadiance = 0.0;

  calcRoughness(PrimaryPerceptualRoughness[pixel], 0.0,
    surface.opaqueSurfaceMaterialInteraction.isotropicRoughness,
    surface.opaqueSurfaceMaterialInteraction.anisotropicRoughness);

  surface.portalSpace = geometryFlags.portalSpace;
  surface.isViewModel = geometryFlags.isViewModel;
  surface.objectMask = geometryFlags.objectMask;
  surface.hitDistance = hitDistance;
  surface.virtualWorldPosition = cameraGetWorldPosition(cb.camera) + cameraDirections.worldDirection * hitDistance;

  return surface;
}
#endif

// Callers that got `compactedPixel` from loadCompactedCoordinate pass it in.
// Looks `compactedPixel` up from `pixel` when it is left at its default.
// Returns a surface rebuilt by RAB_GetInactiveGBufferSurface for an inactive pixel.
// knownActiveCompacted requires a resolved storage coordinate for an active pixel.
RAB_Surface RAB_GetGBufferSurface(ivec2 pixel, bool previousFrame, ivec2 compactedPixel = kInvalidCompactedCoordinate,
    bool knownActiveCompacted = false)
{
  RAB_Surface surface = RAB_EmptySurface();

  if (any(lessThan(pixel, vec2(0))) || any(greaterThanEqual(pixel, ivec2(cb.camera.resolution))))
    return surface;

  if (previousFrame)
  {
#ifdef RAB_HAS_PREVIOUS_GBUFFER
    vec2 data = GBufferLast[pixel];
    surface.hitDistance = data.x;
    uint normalPortalData = asuint(data.y);
    surface.portalSpace = uint8_t(((normalPortalData >> 15) & 0x2) | (normalPortalData & 0x1));
    normalPortalData &= 0xfffefffe;
    surface.opaqueSurfaceMaterialInteraction.shadingNormal = UnpackOctahedralNormal(asfloat(normalPortalData));
#endif

    return surface;
  }

  if (!knownActiveCompacted && all(compactedPixel == kInvalidCompactedCoordinate))
  {
#ifdef RAB_HAS_COMPACTED_GBUFFER
    // Inactive pixels have no compacted GBuffer slot, which the table's sentinel reports.
    uvec2 resolvedCoordinate;
    if (!compactedCoordinateFromPixelIfActive(
          CompactedPixelIndices, TileActiveCounts, uint2(pixel), cb.sparseRenderingArgs, resolvedCoordinate))
    {
      return RAB_GetInactiveGBufferSurface(pixel);
    }

    compactedPixel = ivec2(resolvedCoordinate);
#else
    compactedPixel = pixel;
#endif
  }

#ifdef RAB_HAS_CURRENT_GBUFFER
  // Use a custom version of polymorphicSurfaceMaterialInteractionReadFromGBuffer
  // because a) we don't have the data0 and data1 textures; b) we assume all materials are opaque.
  // The surface is read at the compacted slot, except for the shadow terminator offset and roughness,
  // which are written per pixel.
  const Ray originalPrimaryRay = rayCreatePrimaryFromPixel(cb.camera, pixel);
  surface.minimalRayInteraction = minimalRayInteractionReadFromGBuffer(originalPrimaryRay, compactedPixel, PrimaryViewDirection, PrimaryConeRadius);
  surface.minimalSurfaceInteraction = minimalSurfaceInteractionReadFromGBufferWithError(compactedPixel, PrimaryWorldPositionWorldTriangleNormal, PrimaryPositionError);
#ifdef SHADOW_TERMINATOR_FIX_ALLOWED
  // NOTE: SHADOW_TERMINATOR_FIX_ALLOWED is enabled only for direct lighting passes. Terminator offset must not be present on primary, indirect, volumetrics etc.
  if (cb.shadowTerminatorArgs.enableOffset)
  {
    surface.minimalSurfaceInteraction.shadowTerminatorOffset = SharedTerminatorFix[pixel];
  }
#endif
  surface.opaqueSurfaceMaterialInteraction.shadingNormal = signedOctahedralToSphereDirection(snorm2x16ToFloat2x32(PrimaryWorldShadingNormal[compactedPixel]));
  surface.opaqueSurfaceMaterialInteraction.albedo = PrimaryAlbedo[compactedPixel].rgb;
  surface.opaqueSurfaceMaterialInteraction.opacity = 1.0;
  surface.opaqueSurfaceMaterialInteraction.baseReflectivity = PrimaryBaseReflectivity[compactedPixel].rgb;
  surface.opaqueSurfaceMaterialInteraction.emissiveRadiance = 0.0;
  
  calcRoughness(PrimaryPerceptualRoughness[pixel], 0.0,
    surface.opaqueSurfaceMaterialInteraction.isotropicRoughness,
    surface.opaqueSurfaceMaterialInteraction.anisotropicRoughness);

  const uint primarySurfaceIndex = uint(SharedSurfaceIndex[compactedPixel]);
  uint16_t samplerIndex = 0;

  const uint subsurfaceMaterialIndex = getSubsurfaceMaterialIndex(surfaceMaterials[surfaces[primarySurfaceIndex].surfaceMaterialIndex], samplerIndex);
  surface.opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction = subSurfaceMaterialReadHelper(SharedSubsurfaceData[compactedPixel], SharedSubsurfaceDiffusionProfileData[compactedPixel]);

  GeometryFlags geometryFlags = geometryFlagsReadFromGBuffer(compactedPixel, SharedFlags);
  surface.portalSpace = geometryFlags.portalSpace;
  surface.isViewModel = geometryFlags.isViewModel;
  surface.objectMask = geometryFlags.objectMask;
  surface.hitDistance = PrimaryHitDistance[compactedPixel].x;

  const float3 cameraPositon = cameraGetWorldPosition(cb.camera);
  const float3 primaryRayDirection = cameraPixelCoordinateToDirection(cb.camera, pixel, false).worldDirection;
  surface.virtualWorldPosition = cameraPositon + primaryRayDirection * surface.hitDistance;
#endif

  return surface;
}

#ifdef RAB_HAS_COMPACTED_GBUFFER
// Resolves the pixel and surface of a thread of an RTXDI reuse pass.
// Returns false for a thread without a pixel.
// `launchIndex` is the pixel's slot in the active-pixel list, which indexes compacted reservoirs and neighbor caches.
bool RAB_LoadLaunchSurface(
  uint2 dispatchThreadId,
  uint groupIdX,
  uint groupIndex,
  out int2 pixelCoordinate,
  out uvec2 compactedCoordinate,
  out uint launchIndex,
  out RAB_Surface surface)
{
  pixelCoordinate = int2(dispatchThreadId);
  compactedCoordinate = dispatchThreadId;
  launchIndex = ~0u;
  surface = RAB_EmptySurface();

  uint2 threadIndex;
  if (!loadCompactedCoordinate(dispatchThreadId, groupIdX, groupIndex, ActivePixelCount,
                               cb.camera.resolution, cb.sparseRenderingArgs, threadIndex, compactedCoordinate))
  {
    return false;
  }

  pixelCoordinate = int2(loadLaunchPixelCoordinate(threadIndex, ActivePixelCoords, cb.sparseRenderingArgs));
  launchIndex = threadIndex.x;

#if RTXDI_SPATIAL_SELECTION_PASS
  surface = RAB_GetNeighborSelectionSurface(pixelCoordinate, false, launchIndex);
#elif RTXDI_TEMPORAL_SELECTION_PASS
  surface = RAB_GetGBufferSurface(pixelCoordinate, false, int2(compactedCoordinate), true);
#else
  surface = RAB_GetGBufferSurface(pixelCoordinate, false, int2(compactedCoordinate));
#endif

  return true;
}
#endif

struct RAB_VolumeVisibilityContext
{
  Ray ray;
  MinimalRayInteraction minimalRayInteraction;
};

struct RAB_VolumeInteraction
{
  VolumeInteraction volumeInteraction;
};

// Initialized the random sampler for a given pixel or tile index.
// The pass parameter is provided to help generate different RNG sequences
// for different resampling passes, which is important for image quality.
// In general, a high quality RNG is critical to get good results from ReSTIR.
// A table-based blue noise RNG dose not provide enough entropy, for example.
RAB_RandomSamplerState RAB_InitRandomSampler(uint2 index, uint frameIndex, uint pass)
{
  RAB_RandomSamplerState state;

  uint linearPixelIndex = RTXDI_ZCurveToLinearIndex(index);

  state.index = 1;
  state.seed = RTXDI_JenkinsHash(linearPixelIndex) + frameIndex + pass * 13;

  return state;
}

// Draws a random number X from the sampler, so that (0 <= X < 1).
float RAB_GetNextRandom(inout RAB_RandomSamplerState rng)
{
  return sampleUniformRng(rng);
}

// Only the RTXDI reuse passes bind the neighbor caches and the active list.
// Other passes compile the resampling functions without taking their compact branches, so these return nothing there.
static uint g_rtxdiTemporalNeighborCacheIndex;

int2 RAB_LoadTemporalNeighbor(out float16_t3 previousNormal)
{
  previousNormal = float16_t3(0.0);
#ifdef RAB_HAS_NEIGHBOR_CACHE
  // Temporal selection leaves the cache unbound when reuse is disabled or the history length is zero.
  if (!cb.enableRtxdiTemporalReuse || !cb.rtxdiMaxHistoryLength)
  {
    return int2(-1);
  }

  const uint cacheStride = cb.sparseRenderingArgs.compactedStorageCapacity;
  const uint packedPixel = NeighborCache[g_rtxdiTemporalNeighborCacheIndex];
  previousNormal = float16_t3(
    asfloat(NeighborCache[g_rtxdiTemporalNeighborCacheIndex + 1 * cacheStride]),
    asfloat(NeighborCache[g_rtxdiTemporalNeighborCacheIndex + 2 * cacheStride]),
    asfloat(NeighborCache[g_rtxdiTemporalNeighborCacheIndex + 3 * cacheStride]));
  return packedPixel == ~0u ? int2(-1) : int2(packedPixel & 0xFFFFu, packedPixel >> 16);
#else
  return int2(-1);
#endif
}

static uint g_rtxdiSpatialNeighborCacheIndex;

// Spatial selection fills at most this many slots, and only these slots are stored and loaded.
uint RAB_GetSpatialNeighborSlotCount()
{
  return min(max(uint(cb.rtxdiSpatialSamples), uint(cb.rtxdiDisocclusionSamples)), uint(RTXDI_MAX_ACTIVE_NEIGHBORS));
}

void RAB_LoadSpatialNeighbors(out uint selectedPixels[RTXDI_MAX_ACTIVE_NEIGHBORS])
{
  selectedPixels[0] = ~0u;
  selectedPixels[1] = ~0u;
  selectedPixels[2] = ~0u;
  selectedPixels[3] = ~0u;
#ifdef RAB_HAS_NEIGHBOR_CACHE
  const uint slotCount = RAB_GetSpatialNeighborSlotCount();
  const uint cacheStride = cb.sparseRenderingArgs.compactedStorageCapacity;
  selectedPixels[0] = NeighborCache[g_rtxdiSpatialNeighborCacheIndex];
  if (slotCount > 1)
  {
    selectedPixels[1] = NeighborCache[g_rtxdiSpatialNeighborCacheIndex + 1 * cacheStride];
  }
  if (slotCount > 2)
  {
    selectedPixels[2] = NeighborCache[g_rtxdiSpatialNeighborCacheIndex + 2 * cacheStride];
  }
  if (slotCount > 3)
  {
    selectedPixels[3] = NeighborCache[g_rtxdiSpatialNeighborCacheIndex + 3 * cacheStride];
  }
#endif
}

RAB_Surface RAB_GetActiveNeighborSurface(int2 pixel, uint globalIndex)
{
#ifdef RAB_HAS_NEIGHBOR_CACHE
  if (any(pixel < 0) || any(pixel >= int2(cb.camera.resolution)))
  {
    return RAB_EmptySurface();
  }

  uint2 compactedPixel;
  if (globalIndex != ~0u)
  {
    compactedPixel = storageCoordinateFromGlobalIndex(globalIndex, cb.sparseRenderingArgs);
  }
  else if (!compactedCoordinateFromPixelIfActive(CompactedPixelIndices, TileActiveCounts,
      uint2(pixel), cb.sparseRenderingArgs, compactedPixel))
  {
    return RAB_EmptySurface();
  }
  return RAB_GetGBufferSurface(pixel, false, int2(compactedPixel), true);
#else
  return RAB_EmptySurface();
#endif
}

int2 RAB_GetActiveNeighborPixel(uint globalIndex)
{
#ifdef RAB_HAS_NEIGHBOR_CACHE
  if (globalIndex >= cb.sparseRenderingArgs.compactedStorageCapacity)
  {
    return int2(-1);
  }

  const uint2 pixel = unpackActivePixelCoordinate(ActivePixelCoords[globalIndex]);
  return any(pixel >= cb.camera.resolution) ? int2(-1) : int2(pixel);
#else
  return int2(-1);
#endif
}

#if RTXDI_TEMPORAL_SELECTION_PASS || RTXDI_SPATIAL_SELECTION_PASS
// Selection needs only the surface geometry. Material data is fetched after selecting a neighbor.
RAB_Surface RAB_GetNeighborSelectionSurface(int2 pixel, bool previousFrame, uint globalIndex, out uint2 compactedPixel)
{
  compactedPixel = uint2(0);
  if (previousFrame)
  {
    return RAB_GetGBufferSurface(pixel, true);
  }

  RAB_Surface surface = RAB_EmptySurface();
  if (any(pixel < 0) || any(pixel >= int2(cb.camera.resolution)))
  {
    return surface;
  }

  if (globalIndex != ~0u)
  {
    compactedPixel = storageCoordinateFromGlobalIndex(globalIndex, cb.sparseRenderingArgs);
  }
  else if (!compactedCoordinateFromPixelIfActive(CompactedPixelIndices, TileActiveCounts,
      uint2(pixel), cb.sparseRenderingArgs, compactedPixel))
  {
    return surface;
  }

  surface.hitDistance = PrimaryHitDistance[compactedPixel];
  surface.opaqueSurfaceMaterialInteraction.shadingNormal =
    signedOctahedralToSphereDirection(snorm2x16ToFloat2x32(PrimaryWorldShadingNormal[compactedPixel]));
  surface.portalSpace = geometryFlagsReadFromGBuffer(compactedPixel, SharedFlags).portalSpace;
  return surface;
}

RAB_Surface RAB_GetNeighborSelectionSurface(int2 pixel, bool previousFrame, uint globalIndex = ~0u)
{
  uint2 compactedPixel;
  return RAB_GetNeighborSelectionSurface(pixel, previousFrame, globalIndex, compactedPixel);
}

#if RTXDI_SPATIAL_SELECTION_PASS
// Returns the selection surface of a current-frame spatial candidate at its active-list slot.
// The spatial selection pass reads it from the guide that initial sampling writes.
// Each record holds normal XY, normal Z with portal space in its low two bits, and hit distance.
RAB_Surface RAB_GetSpatialCandidateSurface(int2 pixel, uint globalIndex)
{
  RAB_Surface surface = RAB_EmptySurface();
  if (any(pixel < 0) || any(pixel >= int2(cb.camera.resolution)))
  {
    return surface;
  }
  const uint4 guide = SelectionGuide[globalIndex];
  surface.hitDistance = asfloat(guide.w);
  surface.opaqueSurfaceMaterialInteraction.shadingNormal = asfloat(uint3(guide.xy, guide.z & ~3u));
  surface.portalSpace = PortalSpace2BitsType(guide.z & 3u);
  return surface;
}
#endif

struct RAB_NeighborBasis
{
  float3 ray;
  float2 pixelStep;
  float3 centerPositionScaled;
};

// Precomputes view-space ray data and the virtual center position divided by the scoring sigma.
RAB_NeighborBasis RAB_InitNeighborBasis(int2 pixel, bool previousFrame, float scaledCenterDepth)
{
  const mat4 projectionToView = previousFrame ? cb.camera.prevProjectionToView : cb.camera.projectionToView;
  const float2 ndc = cameraPixelCoordinateToNDC(cb.camera, pixel);
  RAB_NeighborBasis neighborBasis;
  neighborBasis.ray = mul(projectionToView, float4(ndc, 1.0, 1.0)).xyz;
  neighborBasis.pixelStep = float2(projectionToView[0][0], projectionToView[1][1]) *
    float2(2.0, -2.0) / float2(cb.camera.resolution);
  neighborBasis.centerPositionScaled = neighborBasis.ray *
    (scaledCenterDepth * rsqrt(max(dot(neighborBasis.ray, neighborBasis.ray), 1e-12)));
  return neighborBasis;
}

// Returns the global list index of the first retained pixel in the pixel's 8x4 block,
// and the block's retained pixels as a Morton-ordered mask.
uint2 RAB_GetSearchBlock(uint2 pixel, bool previousFrame)
{
  const uint2 block = pixel / uint2(COMPACT_ACTIVE_PIXELS_BLOCK_SIZE_X, COMPACT_ACTIVE_PIXELS_BLOCK_SIZE_Y);
  return previousFrame ? PreviousBlockRankOffsets[block] : BlockRankOffsets[block];
}

int2 RAB_GetActiveNeighborCandidate(
    int2 centerPixel,
    bool previousFrame,
    float searchRadius,
    inout RAB_RandomSamplerState rng,
    out uint candidateGlobalIndex)
{
  candidateGlobalIndex = ~0u;
  if (any(centerPixel < 0) || any(centerPixel >= int2(cb.camera.resolution)) ||
      (previousFrame && !cb.sparseRenderingArgs.rtxdiCompactedHistoryValid))
  {
    return int2(-1);
  }

  // One hash supplies the angle, radius and block rank, so each attempt costs a single random draw.
  const uint proposalBits = sampleUniformIntRng(rng);
  const float angle = float(twoPi) * float(proposalBits & 0x7FFu) * (1.0 / 2048.0);
  const float radius = sqrt(float((proposalBits >> 11) & 0x7FFu) * (1.0 / 2048.0)) * searchRadius;
  float sine;
  float cosine;
  sincos(angle, sine, cosine);
  const float2 offset = radius * float2(cosine, sine);
  const int2 targetPixel = int2(floor(float2(centerPixel) + offset + 0.5));
  if (any(targetPixel < 0) || any(targetPixel >= int2(cb.camera.resolution)))
  {
    return int2(-1);
  }

  // The block's retained pixels occupy consecutive list entries in mask order, so the mask locates the candidate.
  const uint2 block = RAB_GetSearchBlock(uint2(targetPixel), previousFrame);
  const uint count = countbits(block.y);
  if (!count)
  {
    return int2(-1);
  }

  const uint rank = (((proposalBits >> 22) & 0x3FFu) * count) >> 10;
  const uint2 blockSize = uint2(COMPACT_ACTIVE_PIXELS_BLOCK_SIZE_X, COMPACT_ACTIVE_PIXELS_BLOCK_SIZE_Y);
  const int2 pixel = int2((uint2(targetPixel) / blockSize) * blockSize +
    mortonBlockBitToPixelOffset(findNthSetBit(block.y, rank)));
  const float2 separation = float2(pixel - centerPixel);
  if (dot(separation, separation) > searchRadius * searchRadius)
  {
    return int2(-1);
  }
  candidateGlobalIndex = block.x + rank;
  return pixel;
}
#endif

void RAB_SkipRandoms(inout RAB_RandomSamplerState rng, uint count)
{
  rng.index += count;
}

float RAB_GetLightSampleTargetPdfForSurface(RAB_LightSample lightSample, RAB_Surface surface)
{
  if (lightSample.solidAnglePdf <= 0)
    return 0;

  vec3 L = normalize(lightSample.position - surface.minimalSurfaceInteraction.position);

  // Need to compute the transmission pdf if the ray interact with SSS surface
  if (dot(L, surface.minimalSurfaceInteraction.geometryNormal) <= 0.0f &&
      (!cb.sssArgs.enableThinOpaque || !isThinOpaqueSubsurfaceMaterial(surface.opaqueSurfaceMaterialInteraction)))
  {
    return 0;
  }

  surface.opaqueSurfaceMaterialInteraction.albedo = max(surface.opaqueSurfaceMaterialInteraction.albedo, 0.2f);
  surface.opaqueSurfaceMaterialInteraction.isotropicRoughness = max(surface.opaqueSurfaceMaterialInteraction.isotropicRoughness, RAB_RTXDI_MIN_ROUGHNESS);
  surface.opaqueSurfaceMaterialInteraction.anisotropicRoughness = max(surface.opaqueSurfaceMaterialInteraction.anisotropicRoughness, RAB_RTXDI_MIN_ROUGHNESS);

  SurfaceMaterialInteractionSplitWeight weight = opaqueSurfaceMaterialInteractionCalcProjectedWeight(
    surface.opaqueSurfaceMaterialInteraction, surface.minimalRayInteraction, L);

  const vec3 scatteredRadiance = lightSample.radiance * (weight.diffuseReflectionWeight + weight.specularReflectionWeight + weight.diffuseTransmissionWeight);
  float targetPdf = calcBt709Luminance(scatteredRadiance) / lightSample.solidAnglePdf;

  // Make sure we don't produce any weird PDF values which then propagate through ReSTIR
  if (isinf(targetPdf) || isnan(targetPdf))
    targetPdf = 0;

  return max(targetPdf, 0);
}

SurfaceMaterialInteractionSplitWeight RAB_CalculateBRDF(vec3 L, RAB_Surface surface)
{
  SurfaceMaterialInteractionSplitWeight weight;
  weight.diffuseReflectionWeight = vec3(0);
  weight.specularReflectionWeight = vec3(0);
  weight.diffuseTransmissionWeight = vec3(0);

  if (dot(L, surface.minimalSurfaceInteraction.geometryNormal) <= 0.0f &&
      (!cb.sssArgs.enableThinOpaque || !isThinOpaqueSubsurfaceMaterial(surface.opaqueSurfaceMaterialInteraction)))
  {
    return weight;
  }

  weight = opaqueSurfaceMaterialInteractionCalcProjectedWeight(
    surface.opaqueSurfaceMaterialInteraction, surface.minimalRayInteraction, L);
  return weight;
}

float RAB_GetGITargetPdfForSurface(vec3 radiance, vec3 position, RAB_Surface surface)
{
  vec3 L = normalize(position - surface.minimalSurfaceInteraction.position);

  if ((dot(L, surface.minimalSurfaceInteraction.geometryNormal) <= 0.0f ||
       dot(L, surface.opaqueSurfaceMaterialInteraction.shadingNormal) <= 0.0f) &&
      (!cb.sssArgs.enableThinOpaque || !isThinOpaqueSubsurfaceMaterial(surface.opaqueSurfaceMaterialInteraction)))
  {
    return 0;
  }

  surface.opaqueSurfaceMaterialInteraction.isotropicRoughness = max(surface.opaqueSurfaceMaterialInteraction.isotropicRoughness, cb.reSTIRGIRoughnessClamp);
  surface.opaqueSurfaceMaterialInteraction.anisotropicRoughness = max(surface.opaqueSurfaceMaterialInteraction.anisotropicRoughness, cb.reSTIRGIRoughnessClamp);
  if (cb.enableReSTIRGIDemodulatedTargetFunction)
  {
    float originalBrightness = max(0.001f,
      calcBt709Luminance(surface.opaqueSurfaceMaterialInteraction.albedo + surface.opaqueSurfaceMaterialInteraction.baseReflectivity));
    surface.opaqueSurfaceMaterialInteraction.albedo /= originalBrightness;
    surface.opaqueSurfaceMaterialInteraction.baseReflectivity /= originalBrightness;
  }
  else
  {
    surface.opaqueSurfaceMaterialInteraction.albedo = max(0.0, surface.opaqueSurfaceMaterialInteraction.albedo);
  }

  SurfaceMaterialInteractionSplitWeight weight = opaqueSurfaceMaterialInteractionCalcProjectedWeight(
    surface.opaqueSurfaceMaterialInteraction, surface.minimalRayInteraction, L);
  weight.specularReflectionWeight = clamp(weight.specularReflectionWeight, vec3(0), vec3(RAB_RESTIR_GI_MAX_SPECULAR_BRDF));

  const vec3 scatteredRadiance = radiance * (weight.diffuseReflectionWeight + weight.specularReflectionWeight + weight.diffuseTransmissionWeight);
  return clamp(calcBt709Luminance(scatteredRadiance), 0, 1e4);
}

float RAB_GetInitialSampleMISWeight(vec3 roughBRDF, vec3 trueBRDF)
{
  roughBRDF = clamp(roughBRDF, vec3(1e-4), vec3(RAB_RESTIR_GI_MAX_SPECULAR_BRDF));
  trueBRDF = clamp(trueBRDF, vec3(0), vec3(RAB_RESTIR_GI_MAX_SPECULAR_BRDF));
  float initWeight = calcBt709Luminance(trueBRDF) / calcBt709Luminance(trueBRDF + roughBRDF);
  return initWeight*initWeight*initWeight;
}

float RAB_GetLightSampleTargetPdfForVolume(RAB_LightSample lightSample, RAB_VolumeInteraction volumeInteraction)
{
  // Check for invalid Light Samples
  // Note: This happens in cases when there is no chance to sample a specific light (for example when behind a directionally oriented
  // spot or rect light).

  if (lightSample.solidAnglePdf <= 0.0f)
  {
    return 0.0f;
  }

  // Calculate the target PDF based on various weighting factors
  // Note: The target PDF is not normalized so it can be any sort of weight heuristic (rather than something that integrates to 1). This math is
  // based on the volume NEE math and should match reasonably well for minimizing noise in volumetric light selection.

  // Todo: Factor in the HG phase function when we add anisotropy support.
  const float phaseWeight = 1.0f;
  // Note: Safe division to do as the light sample's solid angle PDF has been checked to be not 0 by previous checks.
  const float lightThroughput = 1.0f / lightSample.solidAnglePdf;
  vec3 volumeAttenuation = vec3(1.0f);

  if (cb.volumeArgs.enable)
  {
    const float3 lightDirection = normalize(volumeInteraction.volumeInteraction.position - lightSample.position);
    const float lightSampleDistance = distance(volumeInteraction.volumeInteraction.position, lightSample.position);
    
    volumeAttenuation = calcVolumetricAttenuation(cb.volumeArgs, none, false, lightSampleDistance, lightSample.position, lightDirection);
  }

  const float targetPdf = calcBt709Luminance(lightSample.radiance * volumeAttenuation) * phaseWeight * lightThroughput;

  // Note: Currently stripping NaNs as some light sampling still results in NaNs in rare cases. These should be fixed if this sanitzation
  // is ever to be removed.
  return sanitize(targetPdf, 0.0f);
}

float getProjectionFactor(vec3 cameraPositon, vec3 surfacePosition, vec3 surfaceNormal)
{
  vec3 viewVector = (cameraPositon - surfacePosition);
  float cosine = saturate(dot(normalize(viewVector), surfaceNormal));
  return sqrt(cosine);
}

bool RAB_ShouldDiscardEnlargedPixel(inout RAB_RandomSamplerState rng, RAB_Surface surface, float3 virtualMotionVector)
{
  if (cb.teleportationPortalIndex != 0 || surface.portalSpace == PORTAL_SPACE_PORTAL_COMBINED)
    return false;
  
  vec3 geometryNormal = surface.minimalSurfaceInteraction.geometryNormal;
  if (surface.portalSpace == PORTAL_SPACE_PORTAL_0 || surface.portalSpace == PORTAL_SPACE_PORTAL_1)
  {
    RayPortalHitInfo rayPortalHitInfo = cb.rayPortalHitInfos[(uint)getOpposingRayPortalIndex(surface.portalSpace)];
    if (rayPortalHitInfoIsActive(rayPortalHitInfo))
    {
      mat4 teleportMatrix = rayPortalHitInfo.encodedPortalToOpposingPortalDirection.unpack();
      geometryNormal = mul(mat3(teleportMatrix), geometryNormal);
    }
  }
  const float3 cameraPositon = cameraGetWorldPosition(cb.camera);
  const float3 prevVirtualWorldPosition = surface.virtualWorldPosition + virtualMotionVector;
  float prevFactor = getProjectionFactor(cameraGetPreviousWorldPosition(cb.camera).xyz, prevVirtualWorldPosition, geometryNormal);
  float currFactor = getProjectionFactor(cameraPositon, surface.virtualWorldPosition, geometryNormal);
  float invalidProbability = (currFactor - prevFactor) * 20;

  return RAB_GetNextRandom(rng) < min(0.5, invalidProbability);
}

RAB_Surface RAB_GetSurfaceForTemporalBiasCorrection(RAB_Surface currentSurface, int2 prevPixelID, float3 prevNormal, float3 virtualMotionVector)
{   
    RAB_Surface temporalSurface = currentSurface;
    temporalSurface.opaqueSurfaceMaterialInteraction.shadingNormal = prevNormal;

#ifdef RAB_HAS_PREVIOUS_GBUFFER
    // If we have a previous frame TLAS, use previous frame positions for all objects.
    // If we don't have that TLAS, only use previous frame positions for stationary objects.
    // Without the previous TLAS, using a previous position of a moving object may result in the visibility ray
    // being occluded by the same object, even though the light sample was actually visible on the past frame.
    // This mismatch unnecessarily reduces the piSum value and results in brightening of moving objects.
    if (cb.enablePreviousTLAS || currentSurface.hasStaticObjectMotion || all(virtualMotionVector == 0)) {
      const MinimalSurfaceInteraction temporalSurfaceInteraction = minimalSurfaceInteractionReadFromGBuffer(
        prevPixelID, PreviousWorldPosition_WorldTriangleNormal);
      // Check the previous frames gbuffer data is valid.
      if (!temporalSurfaceInteraction.isValid)
      {
        return temporalSurface;
      }
  
      temporalSurface.minimalSurfaceInteraction.position = temporalSurfaceInteraction.position;
      temporalSurface.minimalSurfaceInteraction.geometryNormal = temporalSurfaceInteraction.geometryNormal;
      temporalSurface.minimalSurfaceInteraction.geometryTangent = temporalSurfaceInteraction.geometryTangent;
      temporalSurface.minimalSurfaceInteraction.geometryBitangent = temporalSurfaceInteraction.geometryBitangent;
      // Note: don't copy the positionError field because it's zero.

#ifdef SHADOW_TERMINATOR_FIX_ALLOWED
      if (cb.shadowTerminatorArgs.enableOffset)
      {
        // for temporal samples, it's important to load corresponding terminator offset;
        // because, if a base sample has the offset, but a temporal sample doesn't,
        // then we introduce a bias (e.g. overbright) during resampling
        // because of the difference of illumination on them
        temporalSurface.minimalSurfaceInteraction.shadowTerminatorOffset = SharedTerminatorFixPrevious[prevPixelID];
      }
#endif
    }
#endif

    return temporalSurface;
}

bool RAB_UseSparseReservoirs()
{
  return cb.sparseRenderingArgs.mode != SparseRenderingMode::Off;
}

bool RAB_GetReservoirPointer(int2 pixel, int page, bool previousFrame, out uint pointer)
{
  pointer = 0;
  if (any(pixel < 0) || any(pixel >= int2(cb.camera.resolution)))
  {
    return false;
  }

  if (!RAB_UseSparseReservoirs())
  {
    pointer = uint(RTXDI_ReservoirPositionToPointer(pixel, cb.camera.resolution, page));
    return true;
  }

#ifdef RAB_HAS_RTXDI_RESERVOIRS
  const uint2 tile = uint2(pixel) / uint2(COMPACT_ACTIVE_PIXELS_TILE_SIZE_X, COMPACT_ACTIVE_PIXELS_TILE_SIZE_Y);
  uint localIndex;
  uint2 tileState;
  if (previousFrame)
  {
#ifdef RAB_HAS_PREVIOUS_COMPACTED_RESERVOIR_MAPPING
    if (!cb.sparseRenderingArgs.rtxdiCompactedHistoryValid)
    {
      return false;
    }
    localIndex = uint(PreviousCompactedPixelIndices[pixel]);
    tileState = PreviousTileActiveCounts[tile];
#else
    return false;
#endif
  }
  else
  {
    localIndex = uint(CompactedPixelIndices[pixel]);
    tileState = TileActiveCounts[tile];
  }

  const uint capacity = cb.sparseRenderingArgs.compactedStorageCapacity;
  if (localIndex == kInvalidCompactedIndex || localIndex >= tileState.x ||
      tileState.y >= capacity || localIndex >= capacity - tileState.y)
  {
    return false;
  }

  pointer = uint(page) * capacity + tileState.y + localIndex;
  return true;
#else
  return false;
#endif
}

// The caller has already checked the current pixel or compacted launch index.
bool RAB_GetCurrentReservoirPointer(int2 pixel, int page, uint globalIndex, out uint pointer)
{
  pointer = 0;
  if (!RAB_UseSparseReservoirs())
  {
    pointer = uint(RTXDI_ReservoirPositionToPointer(pixel, cb.camera.resolution, page));
    return true;
  }

  const uint capacity = cb.sparseRenderingArgs.compactedStorageCapacity;
  if (globalIndex >= capacity)
  {
    return false;
  }
  pointer = uint(page) * capacity + globalIndex;
  return true;
}

#ifdef RAB_HAS_RTXDI_RESERVOIRS
// Returns whether the current or previous frame wrote the reservoir at the pointer.
bool RAB_IsReservoirWritten(uint pointer, bool previousFrame)
{
  const uint frameStamp = RtxdiReservoirBuffer[pointer].data1.w;
  const uint expectedStamp = cb.frameIdx + (previousFrame ? 0u : 1u);
  return frameStamp != 0u && frameStamp == expectedStamp;
}
#endif

bool RAB_IsReservoirAvailable(int2 pixel, int page)
{
  if (any(pixel < 0) || any(pixel >= int2(cb.camera.resolution)))
  {
    return false;
  }

  if (!RAB_UseSparseReservoirs())
  {
    return true;
  }

#ifdef RAB_HAS_RTXDI_RESERVOIRS
  uint pointer;
  if (!RAB_GetReservoirPointer(pixel, page, false, pointer))
  {
    return false;
  }
  return RAB_IsReservoirWritten(pointer, false);
#else
  return false;
#endif
}

#if RTXDI_TEMPORAL_SELECTION_PASS
bool RAB_IsPreviousPixelActive(int2 pixel, int page, uint globalIndex = ~0u)
{
  // has fetched compact list index.
  if (globalIndex != ~0u)
  {
    return true;
  }
  uint pointer;
  return RAB_GetReservoirPointer(pixel, page, true, pointer);
}
#endif

void RAB_StoreReservoirAtPointer(RTXDI_Reservoir reservoir, uint pointer)
{
#ifdef RAB_HAS_RTXDI_RESERVOIRS
  RTXDI_PackedReservoir packedReservoir = RTXDI_PackReservoir(reservoir);
  // Active background pixels can skip writes, so compacted slots still need frame stamps.
  packedReservoir.data1.w = cb.frameIdx + 1u;
  RtxdiReservoirBuffer[pointer] = packedReservoir;
#endif
}

void RAB_StoreReservoir(RTXDI_Reservoir reservoir, int2 pixel, int page)
{
  uint pointer;
  if (RAB_GetReservoirPointer(pixel, page, false, pointer))
  {
    RAB_StoreReservoirAtPointer(reservoir, pointer);
  }
}

void RAB_StoreReservoir(RTXDI_Reservoir reservoir, int2 pixel, int page, uint globalIndex)
{
  uint pointer;
  if (RAB_GetCurrentReservoirPointer(pixel, page, globalIndex, pointer))
  {
    RAB_StoreReservoirAtPointer(reservoir, pointer);
  }
}

void RAB_StoreGIReservoir(ReSTIRGI_Reservoir reservoir, int2 pixel, int page)
{
#ifdef RAB_HAS_RESTIR_GI_RESERVOIRS
    RestirGIReservoirBuffer[RTXDI_ReservoirPositionToPointer(pixel, cb.camera.resolution, page)] = reservoir.pack();
#endif
}

RTXDI_Reservoir RAB_LoadReservoirAtPointer(uint pointer, bool previousFrame)
{
#ifdef RAB_HAS_RTXDI_RESERVOIRS
    const RTXDI_PackedReservoir packedReservoir = RtxdiReservoirBuffer[pointer];
    if (RAB_UseSparseReservoirs())
    {
      const uint expectedStamp = cb.frameIdx + (previousFrame ? 0u : 1u);
      if (packedReservoir.data1.w == 0u || packedReservoir.data1.w != expectedStamp)
      {
        return RTXDI_EmptyReservoir();
      }
    }

    // The buffer is zero-filled on creation, and a zero record would unpack as a valid reservoir for light 0.
    // Sparse rendering reuses pixels that have not written a reservoir since then, so a zero record is treated as empty.
    // A written reservoir for light 0 is unaffected, since holding a sample makes its M at least 1, which keeps data1 nonzero.
    if (all((packedReservoir.data0 | packedReservoir.data1) == 0u))
    {
        return RTXDI_EmptyReservoir();
    }

    return RTXDI_UnpackReservoir(packedReservoir);
#else
    return RTXDI_EmptyReservoir();
#endif
}

RTXDI_Reservoir RAB_LoadReservoir(int2 pixel, int page, bool previousFrame = false)
{
  uint pointer;
  if (!RAB_GetReservoirPointer(pixel, page, previousFrame, pointer))
  {
    return RTXDI_EmptyReservoir();
  }
  return RAB_LoadReservoirAtPointer(pointer, previousFrame);
}

RTXDI_Reservoir RAB_LoadReservoirAtIndex(int2 pixel, int page, uint globalIndex)
{
  uint pointer;
  if (!RAB_GetCurrentReservoirPointer(pixel, page, globalIndex, pointer))
  {
    return RTXDI_EmptyReservoir();
  }
  return RAB_LoadReservoirAtPointer(pointer, false);
}

ReSTIRGI_Reservoir RAB_LoadGIReservoir(int2 pixel, int page)
{
#ifdef RAB_HAS_RESTIR_GI_RESERVOIRS
    return ReSTIRGI_Reservoir.createFromPacked(RestirGIReservoirBuffer[RTXDI_ReservoirPositionToPointer(ivec2(pixel), cb.camera.resolution, int(page))]);
#else
    return ReSTIRGI_Reservoir.createEmpty();
#endif
}

MemoryPolymorphicLight RAB_GetMemoryPolymorphicLight(uint lightID, bool usePreviousLights)
{
  MemoryPolymorphicLight memoryPolymorphicLight;
  if (usePreviousLights)
    memoryPolymorphicLight = previousLights[lightID];
  else
    memoryPolymorphicLight = lights[lightID];

  return memoryPolymorphicLight;
}

DecodedPolymorphicLight RAB_GetDecodedPolymorphicLightWithTypeHint(uint lightID, uint lightType)
{
  const MemoryPolymorphicLight memoryPolymorphicLight = lights[lightID];
  
  DecodedPolymorphicLight decodedPolymorphicLight = decodePolymorphicLight(memoryPolymorphicLight);
  decodedPolymorphicLight.polymorphicType = lightType;

  return decodedPolymorphicLight;
}

// Note: Assumes lightID is valid (e.g. not the invalid light ID reservoirs use to indicate they are invalid).
RAB_LightSample RAB_GetLightSample(uint lightID, float2 lightUV, MinimalSurfaceInteraction minimalSurfaceInteraction, bool usePreviousLights = false)
{
  const MemoryPolymorphicLight memoryPolymorphicLight = RAB_GetMemoryPolymorphicLight(lightID, usePreviousLights);

  return memoryPolymorphicLightSampleArea(memoryPolymorphicLight, lightUV, minimalSurfaceInteraction);
}

RAB_LightSample RAB_GetLightSample(uint lightID, float2 lightUV, RAB_Surface surface, bool usePreviousLights = false)
{
  return RAB_GetLightSample(lightID, lightUV, surface.minimalSurfaceInteraction, usePreviousLights);
}

RAB_LightSample RAB_GetLightSample(uint lightID, float2 lightUV, RAB_VolumeInteraction volumeInteraction, bool usePreviousLights = false)
{
  const MemoryPolymorphicLight memoryPolymorphicLight = RAB_GetMemoryPolymorphicLight(lightID, usePreviousLights);

  return memoryPolymorphicLightSampleArea(memoryPolymorphicLight, lightUV, volumeInteraction.volumeInteraction);
}

RAB_LightSample RAB_GetLightSampleWithTypeHint(uint lightID, float2 lightUV, uint lightType, RAB_Surface surface)
{
  const DecodedPolymorphicLight decodedPolymorphicLight = RAB_GetDecodedPolymorphicLightWithTypeHint(lightID, lightType);
  
  return decodedPolymorphicLightSampleArea(decodedPolymorphicLight, lightUV, surface.minimalSurfaceInteraction);
}

RAB_LightSample RAB_GetLightSampleWithTypeHint(uint lightID, float2 lightUV, uint lightType, RAB_VolumeInteraction volumeInteraction)
{
  const DecodedPolymorphicLight decodedPolymorphicLight = RAB_GetDecodedPolymorphicLightWithTypeHint(lightID, lightType);
  
  return decodedPolymorphicLightSampleArea(decodedPolymorphicLight, lightUV, volumeInteraction.volumeInteraction);
}

RAB_LightSample RAB_GetPortalSpaceLightSample(uint lightIdx, float2 lightUV, uint8_t portalIdx, MinimalSurfaceInteraction minimalSurfaceInteraction, bool usePreviousLights = false)
{
#if RTXDI_NO_PORTALS
  return RAB_GetLightSample(lightIdx, lightUV, minimalSurfaceInteraction, usePreviousLights);
#else
  // For cross portal light, transform to light space
  if (portalIdx != RTXDI_INVALID_PORTAL_INDEX)
  {
    mat4 lightTranform = RAB_GetPortalTransform(portalIdx);
    minimalSurfaceInteraction = minimalSurfaceInteractionAffineTransform(minimalSurfaceInteraction, lightTranform);
  }

  // Light sample is in light space
  RAB_LightSample lightSample = RAB_GetLightSample(lightIdx, lightUV, minimalSurfaceInteraction, usePreviousLights);

  // Transform to portal space
  if (portalIdx != RTXDI_INVALID_PORTAL_INDEX)
  {
    mat4 portalTranform = RAB_GetPortalTransform(RAB_GetOppositePortal(portalIdx));
    lightSample.position = (mul(portalTranform, vec4(lightSample.position, 1))).xyz;
  }

  return lightSample;
#endif
}

RAB_LightSample RAB_GetPortalSpaceLightSample(uint lightIdx, float2 lightUV, uint8_t portalIdx, RAB_Surface surface, bool usePreviousLights = false)
{
  return RAB_GetPortalSpaceLightSample(lightIdx, lightUV, portalIdx, surface.minimalSurfaceInteraction, usePreviousLights);
}

void RAB_GetPortalSamplingProbablity(RAB_Surface surface, out float totalPortalPdf, out vec4 sampleThreshold)
{
#if RTXDI_NO_PORTALS
  totalPortalPdf = 0;
  sampleThreshold = 0;
  return;
#else
  if (!cb.enableRtxdiCrossPortalLight)
  {
    totalPortalPdf = 0;
    sampleThreshold = 0;
    return;
  }

  const float3 position = surface.minimalSurfaceInteraction.position;
  const vec3 normal = surface.opaqueSurfaceMaterialInteraction.shadingNormal;

  // Calculate sampling pdf, assume <= 4 portals
  vec4 portalPdfs = vec4(0.0);
  for (int i = 0; i < cb.numActiveRayPortals; ++i)
  {
    // Cull objects behind the portal
    const vec3 offset = cb.rayPortalHitInfos[i].centroid - position;
    if (!RAB_IsPortalActive(i) || dot(offset, cb.rayPortalHitInfos[i].normal) > 0)
    {
      continue;
    }

    // Cull back-facing surface normals
    vec2 portalDim = vec2(1.0 / cb.rayPortalHitInfos[i].inverseHalfWidth, 1.0 / cb.rayPortalHitInfos[i].inverseHalfHeight);
    float cn = dot(offset, normal);
    float an = dot(cb.rayPortalHitInfos[i].xAxis, normal);
    float bn = dot(cb.rayPortalHitInfos[i].yAxis, normal);
    float minAnBn = -max(portalDim.x * an, portalDim.y * bn);
    if (cn < minAnBn)
    {
      continue;
    }

    // Determine sampling probabilities    
    const vec3 localOffset = offset + cb.rayPortalHitInfos[i].normal * portalDim.y;
    float normalizedDistance = length(localOffset) * cb.rayPortalHitInfos[i].inverseHalfWidth;
    portalPdfs[i] = float16_t(lerp(2.0f, 0.1f / float(cb.numActiveRayPortals), saturate(normalizedDistance * 0.25f)));
  }

  // Calculate sampling thresholds
  float originalSpacePdf = 0.9f;
  totalPortalPdf = dot(portalPdfs, vec4(1));
  sampleThreshold = vec4(1.0);
  if (totalPortalPdf > 0.0f)
  {
    portalPdfs /= totalPortalPdf;
    sampleThreshold = vec4(0);
    sampleThreshold.xyz += portalPdfs.x;
    sampleThreshold.yz  += portalPdfs.y;
    sampleThreshold.z   += portalPdfs.z;
    sampleThreshold.w    = 1.0f;
  }
  totalPortalPdf /= (originalSpacePdf + totalPortalPdf);
#endif
}

bool RAB_TraceLightSampleVisibility(RAB_Surface surface, RAB_LightSample lightSample, uint expectedRayPortalIndex,
  bool lightSampleIsPreTransformed, bool includeTranslucentGeometry, bool usePreviousTLAS, out float3 attenuation)
{
  float3 samplePos = lightSample.position;

#if RTXDI_NO_PORTALS
  const uint8_t visibilityExpectedRayPortalIndex = RTXDI_INVALID_PORTAL_INDEX;
  const PortalSpace2BitsType visibilityPortalSpace = PORTAL_SPACE_NONE;
#else
  if (expectedRayPortalIndex != RTXDI_INVALID_PORTAL_INDEX && !lightSampleIsPreTransformed)
  {
    mat4 portalTranform = RAB_GetPortalTransform(RAB_GetOppositePortal(expectedRayPortalIndex));
    samplePos = (mul(portalTranform, vec4(samplePos, 1))).xyz;
  }
  const uint8_t visibilityExpectedRayPortalIndex = expectedRayPortalIndex;
  const PortalSpace2BitsType visibilityPortalSpace = surface.portalSpace;
#endif

  uint8_t rayMask = OBJECT_MASK_OPAQUE | (surface.objectMask & OBJECT_MASK_ALL_DYNAMIC);
  rayMask |= (cb.enableDirectTranslucentShadows) ? OBJECT_MASK_TRANSLUCENT : 0;
  rayMask |= (cb.enableDirectAlphaBlendShadows) ? OBJECT_MASK_ALPHA_BLEND : 0;

  const bool isThinOpaqueSubsurface = isThinOpaqueSubsurfaceMaterial(surface.opaqueSurfaceMaterialInteraction);

  const VisibilityResult visibility = traceVisibilityRay<visibilityModeEnableSubsurfaceMaterials>(
    surface.minimalSurfaceInteraction, samplePos,
    rayMask, visibilityExpectedRayPortalIndex, visibilityPortalSpace, false,
    0, 0, 1.0,
    surface.isViewModel,
    cb.enablePreviousTLAS && usePreviousTLAS,
    BINDING_INDEX_INVALID, vec2(0.0f),
    isThinOpaqueSubsurface,
    surface.opaqueSurfaceMaterialInteraction.shadingNormal);

  attenuation = visibility.attenuation;

  return !visibility.hasOpaqueHit;
}

bool RAB_TraceGISampleVisibility(RAB_Surface surface, RAB_Surface neighborSurface, ReSTIRGI_Reservoir reservoir, int numPortals)
{
  uint8_t portalID = ReSTIRGI_PortalID2BitTo8Bit(reservoir.getPortalID());
  if (portalID == RTXDI_INVALID_PORTAL_INDEX || portalID < numPortals)
  {
    uint8_t rayMask = OBJECT_MASK_OPAQUE | (surface.objectMask & OBJECT_MASK_ALL_DYNAMIC);
    rayMask |= (cb.enableIndirectAlphaBlendShadows) ? OBJECT_MASK_ALPHA_BLEND : 0;

    const float3 dstPosition = reservoir.getVisibilityPoint(neighborSurface.minimalSurfaceInteraction.position);

    const VisibilityResult visibility = traceVisibilityRay<visibilityModeNone>(
      neighborSurface.minimalSurfaceInteraction, dstPosition,
      rayMask, portalID, surface.portalSpace, false,
      0, 0, RAB_RESTIR_GI_VISIBILITY_SHORTENING,
      surface.isViewModel);

    return !visibility.hasOpaqueHit;
  }
  else
  {
    return false;
  }
}

bool RAB_VolumeReSTIR_TraceNEEVisibility(
  RAB_LightSample lightSample, uint8_t sampledTransportPortalIndex,
  RAB_VolumeVisibilityContext volumeVisibilityContext, RAB_VolumeInteraction volumeInteraction,
  out float3 attenuation)
{
  // Create a Ray to the location sampled on the light

  const Ray visibilityRay = rayCreatePosition(
    volumeVisibilityContext.minimalRayInteraction, volumeInteraction.volumeInteraction, volumeVisibilityContext.ray, lightSample.position);
  
  const VisibilityResult visibility = evalVolumeNEEVisibility(
    lightSample,
    sampledTransportPortalIndex,
    visibilityRay);

  attenuation = visibility.attenuation;

  return !visibility.hasOpaqueHit;
}

uint RAB_GetLightCount()
{
  return cb.lightCount;
}

uint RAB_GetLightTypeCount()
{
  return lightTypeCount;
}

RTXDI_LightRange RAB_GetLightRange(uint lightType)
{
  LightRangeInfo range = cb.lightRanges[lightType];

  RTXDI_LightRange result;
  result.firstIndex = range.offset;
  result.count = range.count;
  result.sampleCount = range.rtxdiSampleCount;
  result.volumeRISSampleCount = range.volumeRISSampleCount;

  return result;
}

float RAB_GetSurfaceIlluminance(int2 pixelPos, bool previousFrame)
{
#ifdef RAB_GRADIENTS_PASS
  if (previousFrame)
  {
    return PreviousRtxdiIlluminance[pixelPos];
  }
  else
  {
    // Only consider gradients for pixels where the primary surface was selected for integration,
    // because otherwise we can get wrong objectMask or viewModel flag, which leads to false gradients.
    // RTXDI illuminance is 0 for pixels with secondary surface integrations, ignore such pixels
    const GeometryFlags geometryFlags = geometryFlagsReadFromGBuffer(pixelPos, SharedFlags);
    if (!geometryFlags.primarySelectedIntegrationSurface)
      // Return a negative value so that RTXDI will skip this pixel entirely
      return -1.0;

    return CurrentRtxdiIlluminance[pixelPos];
  }
#else
  return 0;
#endif
}

int2 RAB_GetTemporalSamplePosition(int2 pixelPos)
{
#ifdef RAB_GRADIENTS_PASS
  const uint packedTemporalPixelPos = TemporalPosition[pixelPos];
  
  if (packedTemporalPixelPos == ~0u)
    return -1.0;

  return unpack16(packedTemporalPixelPos);
#else
  return -1.0;
#endif
}

int ReSTIRGI_GetInitSamplePage()
{
  return 0;
}

int ReSTIRGI_GetTemporalInputPage()
{
  return 1;
}

int ReSTIRGI_GetTemporalOutputPage()
{
  return 2;
}

int ReSTIRGI_GetSpatialInputPage()
{
  return 2;
}

int ReSTIRGI_GetSpatialOutputPage()
{
  return 1;
}

uint32_t RAB_EncodeNormal(float3 normal)
{
  return float2x32ToSnorm2x16(sphereDirectionToSignedOctahedral(normal));
}

float3 RAB_DecodeNormal(uint encodedNormal)
{
  return signedOctahedralToSphereDirection(snorm2x16ToFloat2x32(encodedNormal));
}
