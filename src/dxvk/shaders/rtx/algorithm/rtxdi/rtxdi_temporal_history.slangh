#pragma once

void rtxdiTemporalResamplingWithHistoryValidity(
  bool historyValid, inout RTXDI_Reservoir state, uint2 pixelCoordinate, RAB_Surface surface,
  inout RAB_RandomSamplerState rng, RTXDI_TemporalResamplingParameters tparams,
  out int2 temporalSamplePixelPos, out bool isGBufferSimilar)
{
  temporalSamplePixelPos = -1;
  isGBufferSimilar = false;
  if (historyValid)
  {
    RTXDI_TemporalResampling(state, pixelCoordinate, surface, rng, tparams, temporalSamplePixelPos, isGBufferSimilar);
  }
}

void rtxdiStoreTemporalReprojection(bool historyValid, uint2 pixelCoordinate,
  int2 temporalSamplePixelPos, bool isGBufferSimilar, bool writeGradientPosition)
{
  float currentReprojectionConfidence = 0;
  if (historyValid)
  {
    if (isGBufferSimilar)
    {
      currentReprojectionConfidence = ReprojectionConfidence[temporalSamplePixelPos];
    }
    currentReprojectionConfidence = min(currentReprojectionConfidence + 1.f / kReprojectionConfidenceHistoryLength, 1.f);
  }
  ReprojectionConfidence[pixelCoordinate] = currentReprojectionConfidence;
  if (writeGradientPosition)
  {
    if (!historyValid || !isGBufferSimilar)
    {
      temporalSamplePixelPos = -1;
    }
    TemporalPosition[pixelCoordinate] = pack32(u16vec2(temporalSamplePixelPos));
  }
}
