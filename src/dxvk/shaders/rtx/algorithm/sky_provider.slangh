#pragma once

// The ray tracing passes reach the NUMOS sky only through these functions, see documentation/NumosSky.md.

#include "numos/host/numos_host.slangh"

// Returns true while NUMOS replaces the rasterized sky.
bool skyProviderActive()
{
  return cb.skyProviderActive;
}

// Returns the radiance of the sky, with its clouds, for a ray that left the scene after the camera's first surface.
// The sky's indirect scale applies only to diffuse sky gathers.
// The sun and moon disks belong only on paths that no light sample follows, see "Sky paths" in documentation/NumosSky.md.
vec3 skyProviderRadiance(vec3 directionWorld, uvec2 pixelCoordinate, bool applySkyIndirectScale, uint skyDisks)
{
  const bool isPrimaryRay = false;

  // NUMOS pre-exposes its radiance, and the path tracer works in unscaled radiance.
  return cb.skyRadianceUnscale * evalSkyRadiance(
    directionWorld, skyArgs, pixelCoordinate, cb.frameIdx, cb.isZUp, isPrimaryRay, applySkyIndirectScale, skyDisks);
}

// Returns the transmittance of the clouds between a position and a light that they shadow.
float skyProviderCloudShadow(vec3 worldPosition, vec3 directionToLight)
{
  return sampleCloudGroundShadow_OptionB(worldPosition, directionToLight, skyArgs, cb.isZUp);
}
