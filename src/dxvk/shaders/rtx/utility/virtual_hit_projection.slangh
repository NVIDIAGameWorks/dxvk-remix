#pragma once

struct VirtualHitProjection
{
  float depth;
  float linearViewZ;
  vec2 screenSpaceMotion;
};

// Projects the hit along the pixel's unjittered camera ray; depth is -infinity for a hit at the camera position.
VirtualHitProjection projectVirtualHit(uvec2 pixelCoordinate, float virtualHitDistance, vec3 virtualMotion)
{
  const Ray originalCameraRay = rayCreatePrimaryFromPixel(cb.camera, pixelCoordinate, false);
  const vec3 virtualHitPosition = rayEvaluate(originalCameraRay, virtualHitDistance);
  const vec4 projectionSpacePosition = mul(cb.camera.worldToProjectionJittered, vec4(virtualHitPosition, 1.0f));
  const vec2 ndc = cameraPixelCoordinateToNDC(cb.camera, pixelCoordinate);

  VirtualHitProjection projection;
  projection.depth = projectionSpacePosition.z / projectionSpacePosition.w;
  projection.linearViewZ = cameraWorldPosToLinearViewZ(cb.camera, virtualHitPosition);

  // Forced static-scene motion reprojects the precise NDC and depth rather than the imprecise world position.
  if (cb.forceStaticSceneMotionVectors)
  {
    projection.screenSpaceMotion = cameraCalcStaticSceneMotionVectorPixel(cb.camera, ndc, projection.depth);
  }
  else
  {
    const vec2 prevNDC = cameraWorldPosToPrevNDC(cb.camera, virtualHitPosition + virtualMotion);
    projection.screenSpaceMotion = cameraCalcMotionVectorPixel(cb.camera, ndc, prevNDC);
  }

  return projection;
}
