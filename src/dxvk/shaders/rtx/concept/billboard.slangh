#pragma once

#include "rtx/concept/billboard.h"
#include "rtx/utility/math.slangh"

// Uses the reoriented physical axes and UV derivatives to recover the shading frame.
void calcBillboardTangents(MemoryBillboard billboard, vec3 normal, out vec3 tangent, out vec3 bitangent) {
  vec2 uvDerivativeX = billboard.xAxisUV * billboard.inverseHalfWidth;
  vec2 uvDerivativeY = billboard.yAxisUV * billboard.inverseHalfHeight;

  // A common scale makes the determinant check independent of the overall UV density.
  const float gradientScale = max(max(abs(uvDerivativeX.x), abs(uvDerivativeX.y)),
                                  max(abs(uvDerivativeY.x), abs(uvDerivativeY.y)));
  if (!(gradientScale > 0.f) || !isfinite(gradientScale)) {
    calcOrthonormalBasis(normal, tangent, bitangent);
    return;
  }

  uvDerivativeX /= gradientScale;
  uvDerivativeY /= gradientScale;
  const float determinant = uvDerivativeX.x * uvDerivativeY.y - uvDerivativeX.y * uvDerivativeY.x;
  if (!(abs(determinant) > 1e-8f)) {
    calcOrthonormalBasis(normal, tangent, bitangent);
    return;
  }

  // Normalization cancels the magnitude of the inverse determinant, but its sign determines handedness.
  const float orientation = signNotZero(determinant);
  const vec3 rawTangent = orientation * (uvDerivativeY.y * billboard.xAxis - uvDerivativeX.y * billboard.yAxis);
  const vec3 rawBitangent = orientation * (uvDerivativeX.x * billboard.yAxis - uvDerivativeY.x * billboard.xAxis);
  const vec3 newTangent = orthogonalize(rawTangent, normal);
  const vec3 newBitangent = cross(normal, newTangent);
  if (all(newTangent == vec3(0.f)) || all(newBitangent == vec3(0.f))) {
    calcOrthonormalBasis(normal, tangent, bitangent);
    return;
  }

  tangent = normalize(newTangent);
  bitangent = normalize(newBitangent) * signNotZero(dot(newBitangent, rawBitangent));
}
